#!/usr/bin/python3
"""Strawberry Video Player.

Plays the videos in ~/Videos on HDMI when a display is connected and on the
built-in LCD otherwise. Keys are read straight from the keyboard evdev devices,
so they work whichever display is in use.

HDMI  VLC with Raspberry Pi's DRM video output: the hardware H.264 decoder feeds
      the display directly (zero-copy 1080p). VLC needs the display to itself, so
      the desktop (lightdm) is stopped while it plays and started again after.
LCD   mpv with software decoding and an early downscale to 320x170.

Keys:  Tab LCD <-> HDMI        q / Space / Return  play-pause
       z / x / Del previous    c / f  next
       w back 30 s   e forward 30 s     l loop one <-> loop all
       s volume -    d volume +    a mute    p subtitles (HDMI)    h help    Esc quit

One-time setup for smooth HDMI (lets the player stop the desktop):
       sudo strawberry-video-player --setup        (undo with --unsetup)
"""
import glob
import json
import os
import re
import selectors
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

import evdev
from evdev import ecodes as ec

VERSION = "2.7.14"
DIAG_AT_ACQUIRE = 4.0        # seconds the diagnostics page shows when HDMI is acquired
DIAG_MAX_WAIT = 30.0        # ...and no longer than this if playback never starts
SPLASH_SECONDS = 10.0
VIDEO_EXTS = {".mp4", ".m4v", ".mkv", ".mov", ".avi", ".webm", ".ts", ".m2ts",
              ".mpg", ".mpeg", ".wmv", ".flv", ".ogv", ".3gp"}
SEEK_SECONDS = 30
RESUME_MIN_LENGTH = 120         # only videos at least this long (s) are resumed
RESUME_EDGE = (5, 10)           # nothing saved in the first 5 s; forgotten in the last 10 s
RESUME_STATE = os.path.expanduser("~/.local/state/strawberry-video-player/resume.json")
LCD_DRM = "/dev/dri/cardputer-zero-internal"
LCD_AUDIO_HINT = "platform-sound"          # PipeWire sink name fragment
HDMI_ALSA = "plughw:CARD=vc4hdmi,DEV=0"    # ALSA device name (VLC form)
UID = os.getuid()
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{UID}"
PID = os.getpid()
DEBUG = bool(os.environ.get("STRAWBERRY_DEBUG"))
CONF = os.path.expanduser("~/.config/strawberry-video-player.conf")


def conf_value(key, default=None):
    """key = value lines in ~/.config/strawberry-video-player.conf (# comments)."""
    try:
        for line in open(CONF, encoding="utf-8"):
            line = line.split("#", 1)[0].strip()
            if "=" in line:
                k, v = (x.strip() for x in line.split("=", 1))
                if k == key and v:
                    return v
    except OSError:
        pass
    return default


# 1080p30 by default (the display's 1080p mode with the nearest refresh rate).
HDMI_MODE = os.environ.get("STRAWBERRY_HDMI_MODE") or conf_value("hdmi_mode", "1920x1080@30")


def conf_set(key, value):
    """Write key = value into the config file, keeping its other lines."""
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        lines = []
        try:
            lines = open(CONF, encoding="utf-8").read().splitlines()
        except OSError:
            pass
        done = False
        for i, line in enumerate(lines):
            if line.split("#", 1)[0].split("=", 1)[0].strip() == key and "=" in line:
                lines[i] = "%s = %s" % (key, value)
                done = True
        if not done:
            lines.append("%s = %s" % (key, value))
        with open(CONF, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
    except OSError as e:
        log("could not save", key, ":", e)


def initial_aspect():
    """Display shape at start: STRAWBERRY_DISPLAY_ASPECT, then the config file, else 16:9."""
    return os.environ.get("STRAWBERRY_DISPLAY_ASPECT") or conf_value("display_aspect") or "16:9"


def par_for(text):
    """VLC --monitor-par value for a display whose panel is not 16:9. Some monitors
    stretch the 16:9 signal over a 16:10 (or 4:3) panel, so everything looks too tall.
    Telling VLC the pixel shape makes it letterbox/pillarbox inside the signal, and the
    monitor's stretch then restores the right proportions. None means no correction."""
    if not text:
        return None
    try:
        from fractions import Fraction
        if ":" in text:
            w, h = text.split(":", 1)
            panel = Fraction(w.strip()) / Fraction(h.strip())
        else:
            panel = Fraction(text.strip())
        par = panel / Fraction(16, 9)                  # signal is 16:9 pixels
        if not 0.4 < par < 2.5 or par == 1:
            return None
        par = par.limit_denominator(100)
        return "%d:%d" % (par.numerator, par.denominator)
    except (ValueError, ZeroDivisionError):
        return None


KEYMAP = {
