T0 = time.time()


def log(*a):
    stamp = "%7.2f" % (time.time() - T0) if DEBUG else ""
    print("[strawberry]", stamp, *a, file=sys.stderr, flush=True)


def dbg(*a):
    if DEBUG:
        log(*a)


# ---------------------------------------------------------------- environment
def hdmi_connected():
    for p in glob.glob("/sys/class/drm/card*-HDMI-A-*/status"):
        try:
            if open(p).read().strip() == "connected":
                return True
        except OSError:
            pass
    return False


def wayland_display():
    """Name of the running Wayland compositor socket, or None."""
    env = os.environ.get("WAYLAND_DISPLAY")
    cands = [env] if env else []
    cands += sorted(os.path.basename(p) for p in glob.glob(os.path.join(RUNTIME, "wayland-*"))
                    if not p.endswith(".lock"))
    for c in cands:
        path = c if os.path.isabs(c) else os.path.join(RUNTIME, c)
        try:
            s = socket.socket(socket.AF_UNIX)
            s.settimeout(0.5)
            s.connect(path)
            s.close()
            return c
        except OSError:
            continue
    return None


def cma_total_mb():
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("CmaTotal:"):
                return int(line.split()[1]) // 1024
    except (OSError, ValueError):
        pass
    return 0


def unit_active(unit="lightdm"):
    try:
        return subprocess.run(["systemctl", "is-active", "--quiet", unit],
                              timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def lcd_audio_device():
    try:
        out = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True,
                             text=True, timeout=3,
                             env=dict(os.environ, XDG_RUNTIME_DIR=RUNTIME)).stdout
        for line in out.splitlines():
            name = line.split("\t")[1]
            if LCD_AUDIO_HINT in name:
                return "pipewire/" + name
    except Exception:
        pass
    return "auto"


def next_sub(ids, current):
    """Cycle: off -> first -> second ... -> off. ids are the tracks; current is one of
    them or None for off. Returns the next choice (None = off)."""
    if not ids:
        return None
    if current not in ids:
        return ids[0]
    i = ids.index(current) + 1
    return ids[i] if i < len(ids) else None


def resume_load():
    try:
        with open(RESUME_STATE) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def resume_key(path):
    try:
        return "%s|%d" % (path, os.path.getsize(path))
    except OSError:
        return None


def scan(directory):
    try:
        names = [n for n in os.listdir(directory)
                 if os.path.splitext(n)[1].lower() in VIDEO_EXTS
                 and not n.startswith(".")]
    except OSError:
        return []
    names.sort(key=lambda n: (n.casefold(), n))
    return [os.path.join(directory, n) for n in names
            if os.path.isfile(os.path.join(directory, n))]


def _die_with_parent():
    """Child setup: ask the kernel to kill the player (mpv/VLC) if we die, so a
    killed supervisor can never leave a child holding the display."""
    try:
        import ctypes
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
    except Exception:
        pass


# ------------------------------------------------- console (VT) helpers
# After the desktop stops, keystrokes would land in whatever console is active.
# If a login shell lives there, move to an unused console instead.
LOGIN1 = ["busctl", "--system", "call", "org.freedesktop.login1",
          "/org/freedesktop/login1/seat/seat0", "org.freedesktop.login1.Seat",
          "SwitchTo", "u"]


def active_vt():
    try:
        s = open("/sys/class/tty/tty0/active").read().strip()
    except OSError:
        return None
    return int(s[3:]) if s.startswith("tty") and s[3:].isdigit() else None


def switch_vt(n, wait=4.0):
    try:
        r = subprocess.run(LOGIN1 + [str(n)], capture_output=True, timeout=6)
    except (OSError, subprocess.SubprocessError):
        return False
    if r.returncode != 0:
        dbg("SwitchTo failed:", r.stderr.decode(errors="replace").strip())
        return False
    end = time.time() + wait
    while time.time() < end:
        if active_vt() == n:
            return True
        time.sleep(0.1)
    return False


def used_vts():
    used = set()
    try:
        out = subprocess.run(["loginctl", "list-sessions", "--no-legend"],
                             capture_output=True, text=True, timeout=4).stdout
        for line in out.splitlines():
            sid = line.split()[0]
            v = subprocess.run(["loginctl", "show-session", sid, "-p", "VTNr", "--value"],
                               capture_output=True, text=True, timeout=4).stdout.strip()
            if v.isdigit():
                used.add(int(v))
    except (OSError, subprocess.SubprocessError, IndexError):
        pass
    return used


def quiet_console():
    cur = active_vt()
    if cur is None or cur not in used_vts():
        return
    used = used_vts() | {cur}
    free = next((n for n in range(8, 24) if n not in used), None)
    if free:
        switch_vt(free)


# ---------------------------------------------------------------- stream preflight
HW_PROFILES = {"Baseline", "Constrained Baseline", "Main", "Extended", "High"}


class Prober:
    """Reads each video's stream header with ffprobe (cached) to decide whether the
    Pi's hardware H.264 decoder can take it. The decoder handles 8-bit 4:2:0 H.264
    up to level 4.2 (about 4 reference frames at 1080p); streams above that, such
    as a level 5.1 encode with 10 reference frames, decode to a gray or black
    picture, so those are played with the software decoder instead."""

    def __init__(self):
        self.cache = {}

    def info(self, path):
        if path in self.cache:
            return self.cache[path]
        info = None
        try:
            r = subprocess.run(
                ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                 "stream=codec_name,profile,level,pix_fmt,width,height",
                 "-of", "json", path], capture_output=True, timeout=60)
            streams = json.loads(r.stdout or b"{}").get("streams") or []
            info = streams[0] if streams else None
        except (OSError, subprocess.SubprocessError, ValueError):
            info = None
        self.cache[path] = info
        return info

    def needs_software(self, path):
        """(True, reason) if hardware decoding is known not to work for this file."""
        i = self.info(path)
        if not i or i.get("codec_name") != "h264":
            return False, ""                    # not H.264: VLC uses software anyway
        if i.get("profile") not in HW_PROFILES:
            return True, "profile " + str(i.get("profile"))
        if i.get("pix_fmt") != "yuv420p":
            return True, "pixel format " + str(i.get("pix_fmt"))
        level = i.get("level") or 0
        if level > 42:
            return True, "level %.1f" % (level / 10)
        if (i.get("width") or 0) > 1920 or (i.get("height") or 0) > 1088:
            return True, "%sx%s" % (i.get("width"), i.get("height"))
        return False, ""

    def prefetch(self, paths):
        def work():
            for p in paths:
                self.info(p)
        threading.Thread(target=work, daemon=True).start()


# ---------------------------------------------------------------- LCD backlight
class Backlight:
    """The launcher turns the LCD backlight off when idle. While the player runs
    (info page or LCD video) keep it on: remember the level the user has, and put
    it back whenever it drops to zero. Needs the video group (sysfs file is g+w)."""
    DIR = "/sys/class/backlight/backlight"

    def __init__(self):
        self.ok = os.path.isdir(self.DIR)
        self.target = None
        self.restores = 0

    def hold(self):
        if not self.ok:
            return
        try:
            cur = int(open(self.DIR + "/brightness").read())
            if cur > 0:
                self.target = cur                 # follow whatever level is chosen
                return
            if self.target is None:
                self.target = int(open(self.DIR + "/max_brightness").read())
            with open(self.DIR + "/brightness", "w") as f:
                f.write(str(self.target))
            self.restores += 1
            dbg("LCD backlight was off; restored to", self.target, "(%d)" % self.restores)
        except (OSError, ValueError) as e:
            dbg("backlight control unavailable:", e)
            self.ok = False


# ---------------------------------------------------------------- LCD info page
RED = (250, 32, 33)
WHITE = (255, 255, 255)
GRAY = (126, 126, 126)


def edid_name():
    """Monitor name from the connected HDMI output's EDID (empty if unknown)."""
    for p in sorted(glob.glob("/sys/class/drm/card*-HDMI-A-*/edid")):
        try:
            raw = open(p, "rb").read()
        except OSError:
            continue
        for off in (54, 72, 90, 108):
            blk = raw[off:off + 18]
            if len(blk) == 18 and blk[:3] == b"\0\0\0" and blk[3] == 0xFC:
                return blk[5:18].split(b"\n")[0].decode("ascii", "replace").strip()
    return ""


def hms(sec):
    if sec is None:
        return "--:--:--"
    sec = max(0, int(sec))
    return "%02d:%02d:%02d" % (sec // 3600, sec // 60 % 60, sec % 60)


# ---------------------------------------------------------------- HDMI diagnostics
VIC_NAMES = {1: "VGA", 2: "480p", 3: "480p", 4: "720p60", 5: "1080i60", 16: "1080p60",
             17: "576p", 18: "576p", 19: "720p50", 20: "1080i50", 31: "1080p50",
             32: "1080p24", 33: "1080p25", 34: "1080p30", 63: "1080p120", 93: "4Kp24",
             94: "4Kp25", 95: "4Kp30", 96: "4Kp50", 97: "4Kp60"}


def parse_edid(d):
    """What the display said about itself (EDID base block + CEA extension)."""
    out = {}
    if len(d) < 128 or d[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00":
        return out
    m = (d[8] << 8) | d[9]
    out["maker"] = "".join(chr(((m >> sh) & 31) + 64) for sh in (10, 5, 0))
    out["product"] = "%04X" % (d[10] | d[11] << 8)
    out["week"], out["year"] = d[16], 1990 + d[17]
    out["size_cm"] = (d[21], d[22])
    for i in range(4):
        b = d[54 + 18 * i:72 + 18 * i]
        if b[:3] == b"\x00\x00\x00" and b[3] == 0xFC:
            out["name"] = b[5:18].decode("latin1").split("\n")[0].strip()
    if len(d) >= 256 and d[126]:
        e = d[128:256]
        out["underscan"] = bool(e[3] & 0x80)
        i, end = 4, min(e[2], 127)
        vics = []
        while i < end:
            tag, ln = e[i] >> 5, e[i] & 31
            blk = e[i + 1:i + 1 + ln]
            if tag == 2:
                for v in blk:
                    vics.append((v & 127, bool(v & 128)))
            elif tag == 3 and blk[:3] == b"\x03\x0c\x00" and len(blk) >= 5:
                pa = (blk[3] << 8) | blk[4]
                out["cec"] = "%d.%d.%d.%d" % (pa >> 12, (pa >> 8) & 15, (pa >> 4) & 15, pa & 15)
            i += ln + 1
        out["vics"] = vics
    return out


class HdmiInfo:
    """Gathers what the HDMI connection reports: the display's EDID, its audio
    capabilities (ELD), and the active mode / color settings (kmsprint, if installed)."""

    def __init__(self):
        self.cache, self.at = None, 0.0

    @staticmethod
    def _connector():
        for p in sorted(glob.glob("/sys/class/drm/card*-HDMI-A-*")):
            try:
                if open(p + "/status").read().strip() == "connected":
                    return p
            except OSError:
                pass
        return None

    @staticmethod
    def _audio():
        for f in sorted(glob.glob("/proc/asound/card*/eld#*")):
            try:
                t = open(f).read()
            except OSError:
                continue
            if "monitor_name" not in t:
                continue
            kv = {}
            for line in t.splitlines():
                if "\t" in line:
                    k, v = line.split("\t", 1)
                    kv[k.strip()] = v.strip()
            if "sad0_coding_type" not in kv:
                return "none"
            fmt = re.sub(r"\[.*?\]\s*", "", kv.get("sad0_coding_type", "")) or "?"
            rates = [r for r in re.sub(r"\[.*?\]\s*", "", kv.get("sad0_rates", "")).split() if r.isdigit()]
            khz = "/".join(("%g" % (int(r) / 1000.0)) for r in rates)
            return "%s %sch %s kHz" % (fmt, kv.get("sad0_channels", "?"), khz)
        return None

    @staticmethod
    def _drm():
        """Active mode and connector properties from kmsprint -p (optional tool)."""
        res = {}
        try:
            r = subprocess.run(["kmsprint", "-p"], capture_output=True, timeout=4)
        except (OSError, subprocess.SubprocessError):
            return res
        text = r.stdout.decode(errors="replace")
        m = re.search(r"Crtc \d+ \(\d+\) (\d+x\d+)@([\d.]+)", text)
        if m:
            res["mode"] = "%s @ %g Hz" % (m.group(1), float(m.group(2)))
        for key, name in (("link", "link-status"), ("bpc", "max bpc"),
                          ("range", "Broadcast RGB"), ("cs", "Colorspace")):
            m = re.search(r"^\s+%s \(\d+\) = (\d+)(?: \(([^)]*)\))?" % re.escape(name), text, re.M)
            if m:
                res[key] = (m.group(2) or m.group(1)).strip()
        return res

    def snapshot(self, force=False):
        """Rows for the diagnostics page: [(label, value, ok)], refreshed every 2 s."""
        if not force and self.cache is not None and time.time() - self.at < 2.0:
            return self.cache
        rows = []
        con = self._connector()
        if not con:
            rows = [("Display", "not connected", False)]
        else:
            try:
                e = parse_edid(open(con + "/edid", "rb").read())
            except OSError:
                e = {}
            dr = self._drm()
            name = e.get("name") or "unknown"
            rows.append(("Display", "%s (%s %s)" % (name, e.get("maker", "?"), e.get("product", "?")), True))
            rows.append(("Mode", dr.get("mode", "n/a"), "mode" in dr))
            color = []
            if "bpc" in dr:
                color.append("%s bpc" % dr["bpc"])
            if "range" in dr:
                color.append(re.sub(r"\s*(\d+):(\d+)", r" \1-\2", dr["range"]))
            rows.append(("Color", "  ".join(color) or "n/a", bool(color)))
            audio = self._audio()
            rows.append(("Audio", audio if audio else "n/a", audio not in (None, "none")))
            rows.append(("Link", "%s   CEC %s" % (dr.get("link", "n/a"), e.get("cec", "n/a")),
                         dr.get("link", "Good") == "Good"))
            vics = e.get("vics", [])
            if vics:
                native = [VIC_NAMES.get(v, "VIC%d" % v) for v, nat in vics if nat]
                names = []
                for v, _ in vics:
                    n = VIC_NAMES.get(v)
                    if n and n not in names:
                        names.append(n)
                rows.append(("Native", native[0] if native else "n/a", True))
                rows.append(("Modes", " ".join(names[:6]), True))
            if e.get("year"):
                rows.append(("Made", "%d week %d   %s" % (e["year"], e.get("week", 0),
                                                           "underscan ok" if e.get("underscan") else ""), True))
        self.cache, self.at = rows, time.time()
        return rows


class LcdInfo:
    """While HDMI plays, show an info page on the built-in LCD by drawing straight
    into its framebuffer (saved first, restored on close)."""
    W, H = 320, 170

    def __init__(self):
        self.fd = None
        self.saved = None
        self.stride = self.W * 2
        self.swap = False                       # True if the panel is BGR565
        self.help_until = 0.0
        self.frame = None                       # the last frame written, re-applied by refresh()
        self.frame_at = 0.0
        self.bar_seen = False                   # first frame of a session clears the whole panel
        self.diag_until = 0.0                   # HDMI diagnostics page showing until then
        self.hdmi = HdmiInfo()
        self.note = ""                          # short message shown for a few seconds
        self.note_until = 0.0
        self.last = None
        self.edid = edid_name() or "none"
        self.fonts = {}

    def font(self, size):
        if size not in self.fonts:
            from PIL import ImageFont
            self.fonts[size] = ImageFont.load_default(size=size)
        return self.fonts[size]

    def open(self):
        if self.fd is not None:
            return True
        try:
            import fcntl
            path = os.path.realpath("/dev/fb_lcd")
            name = os.path.basename(path)
            sysd = f"/sys/class/graphics/{name}"
            w, h = (int(x) for x in open(sysd + "/virtual_size").read().split(","))
            bpp = int(open(sysd + "/bits_per_pixel").read())
            if (w, h, bpp) != (self.W, self.H, 16):
                dbg("LCD info: unexpected framebuffer", w, h, bpp)
                return False
            self.stride = int(open(sysd + "/stride").read())
            fd = os.open(path, os.O_RDWR)
            var = bytearray(160)
            fcntl.ioctl(fd, 0x4600, var)         # FBIOGET_VSCREENINFO
            red_offset = int.from_bytes(var[32:36], "little")
            self.swap = red_offset == 0
            self.saved = os.pread(fd, self.stride * self.H, 0)
            self.fd = fd
            self.last = None
            self.bar_seen = False
            return True
        except (OSError, ValueError, ImportError) as e:
            dbg("LCD info unavailable:", e)
            return False

    def close(self):
        if self.fd is None:
            return
        try:
            if self.saved:
                os.pwrite(self.fd, self.saved, 0)
            os.close(self.fd)
        except OSError:
            pass
        self.fd = None
        self.saved = None

    def notice(self, text, seconds=3.0):
        self.note, self.note_until = text, time.time() + seconds
        self.last = None

    def hdmi_line(self, rows):
        """'CX101   1920x1080 @ 60 Hz' for the player page."""
        vals = {label: value for label, value, _ in rows}
        name = vals.get("Display", "no display").split(" (")[0]
        mode = vals.get("Mode", "")
        return name + ("   " + mode if mode and mode != "n/a" else "")

    def toggle_diag(self, seconds=60):
        self.diag_until = 0.0 if time.time() < self.diag_until else time.time() + seconds
        self.hdmi.cache = None
        self.last = None

    def show_help(self, seconds=8):
        self.help_until = time.time() + seconds
        self.last = None

    def _blit(self, img):
        px = img.tobytes()
        out = bytearray(self.stride * self.H)
        swap = self.swap
        for y in range(self.H):
            row = y * self.stride
            base = y * self.W * 3
            for x in range(self.W):
                i = base + x * 3
                r, g, b = px[i], px[i + 1], px[i + 2]
                v = ((b & 0xF8) << 8 | (g & 0xFC) << 3 | r >> 3) if swap \
                    else ((r & 0xF8) << 8 | (g & 0xFC) << 3 | b >> 3)
                o = row + x * 2
                out[o] = v & 255
                out[o + 1] = v >> 8
        self.frame = bytes(out)
        self.frame_at = time.time()
        self._write(self.frame, keep_bar=self.bar_seen)

    # The launcher paints a status strip (wifi, clock, battery) in the top right corner
    # of the panel. Users like seeing it, so we never write over it after the first frame.
    BAR_X, BAR_H = 196, 20

    def _write(self, frame, keep_bar):
        if not keep_bar:
            os.pwrite(self.fd, frame, 0)
            self.bar_seen = True
            return
        rows = self.stride
        for y in range(self.BAR_H):                      # top rows: left part only
            o = y * rows
            os.pwrite(self.fd, frame[o:o + self.BAR_X * 2], o)
        o = self.BAR_H * rows
        os.pwrite(self.fd, frame[o:], o)

    def refresh(self, every=0.5):
        """While we run, the launcher also keeps painting parts of its lock screen (a
        wallpaper patch, a caption) on this panel. Re-apply our last frame a couple of
        times a second so those bits are covered at once, leaving the status strip alone.
        (Rewriting identical bytes is cheap and does not flicker.)"""
        if self.fd is None or self.frame is None or time.time() - self.frame_at < every:
            return
        self.frame_at = time.time()
        try:
            self._write(self.frame, keep_bar=True)
        except OSError:
            pass

    def fit(self, text, size, width):
        f = self.font(size)
        if f.getlength(text) <= width:
            return text
        while text and f.getlength(text + "...") > width:
            text = text[:-1]
        return text + "..."

    SPLASH = "/usr/share/strawberry-video-player/splash.png"
    ICONS = ("/usr/share/icons/hicolor/256x256/apps/strawberry-video-player.png",
             "/usr/share/APPLaunch/share/images/strawberry-video-player.png")

    def page(self, kind, directory=None, hdmi_ok=True, note=""):
        """Full-screen splash or 'no videos' page (needs open())."""
        if self.fd is None:
            return
        from PIL import Image, ImageDraw
        img = Image.new("RGB", (self.W, self.H), (0, 0, 0))
        d = ImageDraw.Draw(img)
        if kind == "setup":
            d.text((14, 32), "Smooth HDMI setup", fill=RED, font=self.font(22), anchor="ls")
            d.text((14, 58), "HDMI is in window mode. For smooth", fill=WHITE, font=self.font(15), anchor="ls")
            d.text((14, 78), "full-screen video, open a terminal on", fill=WHITE, font=self.font(15), anchor="ls")
            d.text((14, 98), "this device and type:", fill=WHITE, font=self.font(15), anchor="ls")
            d.rounded_rectangle([14, 108, 306, 142], radius=6, outline=RED, width=2)
            d.text((160, 131), "sudo strawberry-video-player --setup", fill=WHITE, font=self.font(14), anchor="ms")
            d.text((14, 163), "Then restart the player.   Esc: quit", fill=GRAY, font=self.font(12), anchor="ls")
        elif kind == "splash":
            try:
                img.paste(Image.open(self.SPLASH).convert("RGB").resize((self.W, self.H)))
            except (OSError, ValueError):
                for path in self.ICONS:
                    try:
                        ic = Image.open(path).convert("RGBA").resize((104, 104), Image.LANCZOS)
                        img.paste(ic, (18, 33), ic)
                        break
                    except (OSError, ValueError):
                        continue
            d.text((138, 82), "Strawberry", fill=WHITE, font=self.font(24), anchor="ls")
            d.text((138, 108), "Video Player", fill=WHITE, font=self.font(24), anchor="ls")
            d.text((138, 128), "Version " + VERSION, fill=RED, font=self.font(15), anchor="ls")
            d.text((138, 152), "www.videostrawberry.com", fill=GRAY, font=self.font(13), anchor="ls")
        else:
            home = os.path.expanduser("~")
            shown = ("~" + directory[len(home):]) if directory.startswith(home) else directory
            d.text((14, 32), "No videos found", fill=RED, font=self.font(22), anchor="ls")
            d.text((14, 58), "Videos may be added to", fill=WHITE, font=self.font(15), anchor="ls")
            d.text((14, 82), self.fit(shown, 18, 292), fill=WHITE, font=self.font(18), anchor="ls")
            d.text((14, 101), "Or insert a USB drive. Plays right away.", fill=GRAY, font=self.font(13), anchor="ls")
            edge = RED if hdmi_ok else GRAY
            d.rounded_rectangle([14, 111, 306, 145], radius=6, outline=edge, width=2)
            if hdmi_ok:
                d.text((160, 134), "Press  t  for test patterns", fill=WHITE, font=self.font(18), anchor="ms")
            else:
                d.text((160, 134), "t: test patterns (needs HDMI)", fill=GRAY, font=self.font(15), anchor="ms")
            if note:
                d.text((14, 163), self.fit(note, 12, 292), fill=RED, font=self.font(12), anchor="ls")
            else:
                d.text((14, 163), "Esc: quit", fill=GRAY, font=self.font(12), anchor="ls")
        self.last = None
        self._blit(img)

    def setup(self):
        """Shown while HDMI plays in a window because the polkit rule is missing."""
        if self.fd is None:
            return
        if self.last == "setup":
            self.refresh()
            return
        self.page("setup")
        self.last = "setup"

    def empty(self, directory, hdmi_ok=True):
        """The 'no videos' page, redrawn only when something on it changes."""
        note = self.note if time.time() < self.note_until else ""
        state = ("empty", directory, hdmi_ok, note)
        if self.fd is None:
            return
        if state == self.last:
            self.refresh()
            return
        self.page("empty", directory, hdmi_ok, note)
        self.last = state

    def draw(self, title, status, pos, length, volume, muted):
        if self.fd is None:
            return
        helping = time.time() < self.help_until
        note = self.note if time.time() < self.note_until else ""
        rows = self.hdmi.snapshot()
        diag = tuple(rows) if (not helping and time.time() < self.diag_until) else None
        link = self.hdmi_line(rows)
        state = (helping, title, status, pos, length, volume, muted, note, diag, link)
        if state == self.last:
            self.refresh()
            return
        self.last = state
        from PIL import Image, ImageDraw
        img = Image.new("RGB", (self.W, self.H), (0, 0, 0))
        d = ImageDraw.Draw(img)
        if diag is not None:
            d.text((14, 22), "HDMI diagnostics", fill=RED, font=self.font(16), anchor="ls")
            for i, (label, value, ok) in enumerate(diag[:8]):
                y = 42 + i * 15
                d.text((14, y), label, fill=GRAY, font=self.font(12), anchor="ls")
                d.text((78, y), self.fit(value, 13, 236), fill=WHITE if ok else RED,
                       font=self.font(13), anchor="ls")
            d.text((14, 164), "i: back", fill=GRAY, font=self.font(12), anchor="ls")
        elif helping:
            d.text((14, 22), "Strawberry Video Player", fill=RED, font=self.font(16), anchor="ls")
            for i, (keys, desc) in enumerate(HELP_LINES):
                y = 36 + i * 13
                d.text((14, y), keys, fill=WHITE, font=self.font(12), anchor="ls")
                d.text((100, y), desc, fill=WHITE, font=self.font(12), anchor="ls")
        else:
            d.text((14, 24), self.fit(title, 16, 292), fill=WHITE, font=self.font(16), anchor="ls")
            d.text((14, 48), "HDMI Output", fill=RED, font=self.font(16), anchor="ls")
            d.text((14, 72), self.fit(link, 15, 292), fill=WHITE, font=self.font(15), anchor="ls")
            if note:
                d.text((14, 98), self.fit(note, 12, 292), fill=RED, font=self.font(12), anchor="ls")
            else:
                d.text((14, 90), "Tab:Swap screens  i:HDMI diagnostics",
                       fill=WHITE, font=self.font(12), anchor="ls")
                d.text((14, 105), "t:Test patterns  h:Help", fill=WHITE, font=self.font(12), anchor="ls")
            x0, x1, y = 14, 306, 119
            d.rectangle([x0, y, x1, y + 2], fill=GRAY)
            if length and pos is not None:
                fill = int((x1 - x0) * min(1.0, max(0.0, pos / length)))
                if fill > 0:
                    d.rectangle([x0, y, x0 + fill, y + 2], fill=RED)
            left = status if (pos is None and not length) else "%s %s / %s" % (status, hms(pos), hms(length))
            d.text((14, 141), left, fill=WHITE, font=self.font(15), anchor="ls")
            right = "vol: mute" if muted else "vol: %d" % round(volume / 10)
            d.text((306, 141), right, fill=WHITE, font=self.font(15), anchor="rs")
        self._blit(img)


# ---------------------------------------------------------------- desktop lease
class DesktopLease:
    """Stops the desktop (lightdm) so VLC can own the HDMI display, and starts it
    again afterwards. Needs permission to manage lightdm.service: either a polkit
    rule (see --setup) or the passwordless sudo that the stock image gives the pi
    user (tried as "sudo -n systemctl stop|start lightdm", nothing else). A watcher
    process restarts the desktop if the player is killed without cleaning up."""
    UNIT = "lightdm"

    def __init__(self):
        self.held = False
        self.stopped = False
        self.guard = None
        self.sudo = False           # the plain call was refused, sudo -n worked
        self.failed = False         # neither worked: the user needs --setup

    def _systemctl(self, verb, timeout=30):
        tries = [["systemctl", "--no-ask-password", verb, self.UNIT]]
        sudo = ["sudo", "-n"] + tries[0]
        tries = [sudo] if self.sudo else tries + [sudo]
        for cmd in tries:
            try:
                r = subprocess.run(cmd, capture_output=True, timeout=timeout,
                                   stdin=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError) as e:
                dbg("systemctl", verb, "failed:", e)
                continue
            if r.returncode == 0:
                self.sudo = cmd is sudo
                return True
            dbg("systemctl", verb, self.UNIT, "->", r.stderr.decode(errors="replace").strip())
        return False

    def acquire(self):
        if self.held:
            return True
        if os.environ.get("STRAWBERRY_NO_LEASE"):          # headless testing
            self.held = True
            return True
        if not unit_active(self.UNIT):                     # no desktop to stop
            self.held = True
            return True
        if not self._systemctl("stop"):
            self.failed = True
            return False
        self.failed = False
        self.held = True
        self.stopped = True
        self.guard = subprocess.Popen(
            ["sh", "-c", 'p=$1; shift; while kill -0 "$p" 2>/dev/null; do sleep 1; done;'
             ' exec "$@"', "sh", str(PID)] + (["sudo", "-n"] if self.sudo else [])
            + ["systemctl", "--no-ask-password", "start", self.UNIT],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
        quiet_console()
        time.sleep(0.5)
        return True

    def release(self):
        if not self.held:
            return
        self.held = False
        if os.environ.get("STRAWBERRY_NO_LEASE") or not self.stopped:
            return
        self.stopped = False
        if self.guard:
            self.guard.terminate()
            self.guard.wait()
            self.guard = None
        if not self._systemctl("start"):
            log("could not restart the desktop (", self.UNIT, ")")


# ---------------------------------------------------------------- mpv engine
class MpvEngine:
    """mpv driven over its JSON IPC socket: the LCD, and a desktop window on HDMI
    when the VLC path is unavailable."""
    name = "mpv"

    def __init__(self, output, loop_one=True):
        self.output = output                   # "lcd" or "hdmi" (window)
        self.loop_one = loop_one
        self.sock_path = os.path.join(RUNTIME, f"strawberry-mpv-{PID}.sock")
        self.proc = None
        self.sock = None
        self.buf = b""
        self.replies = {}
        self.req = 0
        self.paused = False
        self.events = []

    # -- process
    def cmd(self):
        c = ["mpv", "--no-config", "--idle=yes", "--force-window=yes",
             "--no-terminal", "--msg-level=all=warn",
             f"--input-ipc-server={self.sock_path}", "--input-conf=/dev/null",
             "--no-input-default-bindings", "--no-input-builtin-bindings",
             "--no-input-vo-keyboard", "--no-osc", "--no-input-cursor",
             "--cursor-autohide=always", "--osd-level=1", "--osd-duration=1500",
             "--loop-file=" + ("inf" if self.loop_one else "no"),
             "--sid=no", "--audio-display=no", "--no-resume-playback",
             "--no-save-position-on-quit", "--vd-lavc-threads=4",
             "--cache=yes", "--demuxer-max-bytes=24MiB",
             "--demuxer-max-back-bytes=4MiB", "--hr-seek=no", "--keep-open=no",
             "--hwdec=no", "--vd-lavc-skiploopfilter=all", "--vd-lavc-fast"]
        if DEBUG:
            c += [f"--log-file={os.path.join(RUNTIME, 'strawberry-mpv.log')}",
                  "--msg-level=all=v"]
        if self.output == "lcd":
            c += ["--vo=drm", f"--drm-device={LCD_DRM}", "--drm-connector=SPI-1",
                  "--sws-scaler=fast-bilinear",
                  # shrink early with a cheap planar scale; the VO then only converts
                  # a tiny frame (otherwise its single thread saturates)
                  "--vf=lavfi=[scale=w=320:h=170:force_original_aspect_ratio=decrease"
                  ":flags=fast_bilinear]",
                  "--framedrop=vo", "--osd-font-size=36",
                  f"--audio-device={lcd_audio_device()}"]
        else:
            # GPU renderer only with a big enough CMA pool (it segfaults when the pool
            # runs out); otherwise shared-memory output (stable but CPU-bound).
            vo = os.environ.get("STRAWBERRY_HDMI_VO") or (
                "gpu" if cma_total_mb() >= 96 else "wlshm")
            c += ["--vo=" + vo, "--fullscreen", "--ao=alsa",
                  "--sws-scaler=fast-bilinear",
                  "--audio-device=alsa/" + HDMI_ALSA]
            if vo == "gpu":
                c += ["--gpu-context=wayland"]
        return c

    def start(self):
        env = dict(os.environ, XDG_RUNTIME_DIR=RUNTIME)
        if self.output == "hdmi":
            env["WAYLAND_DISPLAY"] = wayland_display() or "wayland-0"
        try:
            os.unlink(self.sock_path)
        except OSError:
            pass
        cmd = self.cmd()
        dbg("mpv:", " ".join(cmd))
        self.proc = subprocess.Popen(cmd, env=env, stdin=subprocess.DEVNULL,
                                     preexec_fn=_die_with_parent)
        deadline = time.time() + 8
        while time.time() < deadline:
            if self.proc.poll() is not None:
                return False
            try:
                s = socket.socket(socket.AF_UNIX)
                s.connect(self.sock_path)
                s.setblocking(False)
                self.sock = s
                self.buf = b""
                self._send(["observe_property", 1, "pause"])
                return True
            except OSError:
                time.sleep(0.1)
        return False

    def stop(self, release=True):
        if self.sock:
            try:
                self._send(["quit"])
            except OSError:
                pass
            self.sock.close()
            self.sock = None
        if self.proc:
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
                    self.proc.wait()
            self.proc = None
        try:
            os.unlink(self.sock_path)
        except OSError:
            pass

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def exit_code(self):
        return self.proc.returncode if self.proc else None

    def fileno(self):
        return self.sock.fileno() if self.sock else None

    def degrade(self):
        pass                                    # already software-decoding

    # -- IPC
    def _send(self, cmd, rid=None):
        msg = {"command": cmd}
        if rid is not None:
            msg["request_id"] = rid
        self.sock.sendall(json.dumps(msg).encode() + b"\n")

    def pump(self):
        """Read pending data; returns a list of 'loaded' / 'eof' / 'error'."""
        try:
            data = self.sock.recv(65536)
        except BlockingIOError:
            return self._take()
        except OSError:
            data = b""
        if data:
            self.buf += data
            while b"\n" in self.buf:
                line, self.buf = self.buf.split(b"\n", 1)
                try:
                    self._on_msg(json.loads(line))
                except ValueError:
                    pass
        return self._take()

    def _take(self):
        ev, self.events = self.events, []
        return ev

    def _on_msg(self, m):
        if "request_id" in m:
            self.replies[m["request_id"]] = m
            return
        ev = m.get("event")
        if ev == "property-change" and m.get("name") == "pause":
            self.paused = bool(m.get("data"))
        elif ev == "file-loaded":
            self.events.append("loaded")
        elif ev == "end-file":
            if m.get("reason") == "eof":
                self.events.append("eof")
            elif m.get("reason") == "error":
                self.events.append("error")

    def _request(self, cmd, timeout=1.5):
        if not self.sock:
            return None
        self.req += 1
        rid = self.req
        try:
            self._send(cmd, rid)
        except OSError:
            return None
        end = time.time() + timeout
        while time.time() < end and rid not in self.replies:
            got = self.pump()
            self.events.extend(got)
            time.sleep(0.01)
        r = self.replies.pop(rid, None)
        return r.get("data") if r and r.get("error") == "success" else None

    # -- controls
    def position(self, timeout=1.5):
        return self._request(["get_property", "time-pos"], timeout)

    def length(self):
        return self._request(["get_property", "duration"], 1.0)

    def load(self, path, start=0.0, paused=False, mode="default"):
        opts = []
        if start > 1:
            opts.append(f"start={start:.2f}")
        if paused:
            opts.append("pause=yes")
        self._send(["loadfile", path, "replace", -1, ",".join(opts)])
        if not paused:
            self._send(["set_property", "pause", False])
        self.paused = paused

    def toggle_pause(self):
        self._send(["cycle", "pause"])
        return "Paused" if not self.paused else "Playing"

    def seek_rel(self, delta):
        self._send(["seek", delta, "relative"])

    def set_loop_one(self, on):
        self.loop_one = on
        self._send(["set_property", "loop-file", "inf" if on else "no"])

    def set_volume(self, percent, muted):
        self._send(["set_property", "volume", percent])
        self._send(["set_property", "mute", bool(muted)])

    def say(self, text, ms=1500):
        if self.sock:
            try:
                self._send(["show-text", text, ms])
            except OSError:
                pass

    def poll(self):
        return []                               # events arrive on the socket


# ---------------------------------------------------------------- VLC engine
_vlc_runs = 0


class VlcEngine:
    """VLC (cvlc) with Raspberry Pi's DRM video output, driven over VLC's rc
    interface on a UNIX socket. Hardware decode, zero-copy to the display."""
    name = "vlc"
    LOAD_GRACE = 45.0        # a cold 9 GB file can take 10+ s to open

    def __init__(self, loop_one=True, lease=None, aspect="16:9"):
        self.loop_one = loop_one
        self.lease = lease or DesktopLease()
        self.aspect = aspect
        self.sock_path = os.path.join(RUNTIME, f"strawberry-vlc-{PID}.sock")
        self.proc = None
        self.sock = None
        self.buf = b""
        self.paused = False
        self.mode = "default"            # "default" (hardware where possible) or "sw"
        self.loading_until = 0.0
        self.ever_played = False
        self.loaded_sent = False

    # -- process
    def cmd(self):
        c = ["cvlc", "--extraintf", "oldrc", "--rc-unix", self.sock_path, "--rc-fake-tty",
             "--no-osd", "--no-video-title-show", "--no-snapshot-preview",
             "--no-media-library", "--no-lua", "--no-sub-autodetect-file",
             "--aout", "alsa", "--alsa-audio-device", HDMI_ALSA,
             "--vout", os.environ.get("STRAWBERRY_VLC_VOUT", "drm_vout"),
             # the Pi's decoder asks for ~20 full-size buffers by default, which
             # would exhaust the CMA pool; fewer is plenty
             "--avcodec-options={num_capture_buffers=12,num_output_buffers=6}",
             # Without this VLC leaves the display in whatever mode the console left
             # (often 1024x768) and boxes the picture inside it: wrong aspect ratio.
             # Ask for 1080p30: the display's 1080p mode with the nearest refresh rate
             # is used (many displays list only 50/60 Hz, so that is what they get).
             "--drm-vout-mode=" + HDMI_MODE,
             "--image-duration=-1",                   # test patterns are stills: hold them
             "--fullscreen"]
        par = par_for(self.aspect)
        if par:
            c += ["--monitor-par=" + par]
        if self.mode == "sw":
            # this Pi build of VLC picks its hardware decoder by name, so naming the
            # software one is the only way to force it (--avcodec-hw=none does not)
            c += ["--avcodec-codec=h264"]
        c += ["-vv"] if DEBUG else ["--quiet"]
        c += os.environ.get("STRAWBERRY_VLC_ARGS", "").split()   # test overrides
        return c

    def start(self):
        if not self.lease.acquire():
            log("cannot take over the display (desktop could not be stopped)")
            return False
        try:
            os.unlink(self.sock_path)
        except OSError:
            pass
        cmd = self.cmd()
        dbg("vlc:", " ".join(cmd))
        global _vlc_runs
        _vlc_runs += 1
        err = (open(os.path.join(RUNTIME, f"strawberry-vlc-{_vlc_runs}.log"), "wb")
               if DEBUG else subprocess.DEVNULL)
        self.proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=err, preexec_fn=_die_with_parent)
        deadline = time.time() + 15
        while time.time() < deadline:
            if self.proc.poll() is not None:
                break
            try:
                s = socket.socket(socket.AF_UNIX)
                s.connect(self.sock_path)
                s.setblocking(False)
                self.sock = s
                self.buf = b""
                self._drain()
                return True
            except OSError:
                time.sleep(0.15)
        self.stop()
        return False

    def stop(self, release=True):
        if self.sock:
            try:
                self.sock.sendall(b"quit\n")
            except OSError:
                pass
            self.sock.close()
            self.sock = None
        if self.proc:
            try:
                self.proc.wait(timeout=4)
            except subprocess.TimeoutExpired:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
                    self.proc.wait()
            self.proc = None
        try:
            os.unlink(self.sock_path)
        except OSError:
            pass
        if release:
            self.lease.release()

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def exit_code(self):
        return self.proc.returncode if self.proc else None

    def fileno(self):
        return None                              # polled, not selected

    def degrade(self):
        pass

    # -- rc interface
    def _drain(self):
        try:
            while True:
                d = self.sock.recv(65536)
                if not d:
                    return
                self.buf += d
        except (BlockingIOError, OSError):
            pass

    def _lines(self):
        self._drain()
        out = []
        while b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            out.append(line.decode(errors="replace").strip())
        return out

    def _ask(self, command, timeout=1.0, want_int=False):
        """Send an rc command. Replies are interleaved with 'status change' lines,
        so pick out the bare-number reply for queries."""
        if not self.sock:
            return None
        self._lines()                            # discard stale output
        try:
            self.sock.sendall(command.encode() + b"\n")
        except OSError:
            return None
        end = time.time() + timeout
        seen = []
        while time.time() < end:
            for line in self._lines():
                seen.append(line)
                if want_int and re.fullmatch(r"-?\d+", line):
                    return int(line)
            if not want_int and any("returned" in l for l in seen):
                break
            time.sleep(0.03)
        return None if want_int else "\n".join(seen)

    # -- controls
    def position(self, timeout=1.0):
        return self._ask("get_time", timeout, want_int=True)

    def length(self):
        return self._ask("get_length", 1.0, want_int=True)

    def _playing(self):
        return self._ask("is_playing", 0.8, want_int=True)

    def _wait_playing(self, timeout=6.0):
        end = time.time() + timeout
        while time.time() < end:
            if self._playing() == 1:
                return True
            time.sleep(0.2)
        return False

    def load(self, path, start=0.0, paused=False, mode="default"):
        if mode != self.mode:
            self.mode = mode
            self.stop(release=False)             # keep the desktop stopped
            if not self.start():
                raise OSError("could not restart VLC in %s mode" % mode)
        self._ask("clear", 1.0)
        self._ask("add " + path, 2.0)
        self.loading_until = time.time() + self.LOAD_GRACE
        self.ever_played = False
        self.loaded_sent = False
        self.paused = False
        self.set_loop_one(self.loop_one)
        if start > 1 or paused:
            if self._wait_playing():
                if start > 1:
                    self._ask(f"seek {int(start)}", 1.0)
                if paused:
                    self._ask("pause", 1.0)
                    self.paused = True

    def toggle_pause(self):
        self._ask("pause", 1.0)
        self.paused = not self.paused
        return "Paused" if self.paused else "Playing"

    def _ask_until(self, command, marker, timeout=1.5):
        """Send an rc command and collect its multi-line reply up to a marker line."""
        if not self.sock:
            return []
        self._lines()
        try:
            self.sock.sendall(command.encode() + b"\n")
        except OSError:
            return []
        end, seen = time.time() + timeout, []
        while time.time() < end:
            for line in self._lines():
                seen.append(line)
                if marker in line:
                    return seen
            time.sleep(0.03)
        return seen

    def subtitles(self):
        """([(id, label)], current id or None) from the rc 'strack' listing."""
        tracks, current = [], None
        for line in self._ask_until("strack", "end of Subtitle Track"):
            m = re.match(r"\|\s*(-?\d+)\s*-\s*(.*?)(\s*\*)?\s*$", line)
            if not m or int(m.group(1)) < 0:
                continue
            tid, text = int(m.group(1)), m.group(2)
            lang = re.search(r"\[(.+)\]", text)
            n = len(tracks) + 1
            tracks.append((tid, lang.group(1) if lang else (re.sub(r"^Track \d+\s*-?\s*", "", text) or f"Track {n}")))
            if m.group(3):
                current = tid
        return tracks, current

    def sub_cycle(self):
        tracks, current = self.subtitles()
        if not tracks:
            return "No subtitles"
        choice = next_sub([t for t, _ in tracks], current)
        self._ask(f"strack {choice if choice is not None else -1}", 1.0)
        if choice is None:
            return "Subtitles: off"
        return "Subtitles: " + dict(tracks)[choice]

    def seek_rel(self, delta):
        # this VLC treats "seek +N" as absolute, so compute the target ourselves
        pos = self.position()
        if pos is None:
            return
        self._ask(f"seek {max(0, pos + int(delta))}", 1.0)

    def set_loop_one(self, on):
        self.loop_one = on
        self._ask("repeat " + ("on" if on else "off"), 1.0)

    def set_volume(self, percent, muted):
        # VLC's rc volume scale: 256 = 100 %
        self._ask("volume %d" % (0 if muted else int(percent * 256 / 100)), 1.0)

    def say(self, text, ms=1500):
        dbg("osd:", text)                        # VLC's DRM output has no OSD here

    def pump(self):
        return []

    def poll(self):
        """Called about once a second: detect start-of-play, end-of-file, errors."""
        ev = []
        playing = self._playing()
        if playing == 1:
            if not self.ever_played:
                self.ever_played = True
            if not self.loaded_sent:
                self.loaded_sent = True
                ev.append("loaded")
        elif playing == 0 and time.time() >= self.loading_until:
            ev.append("eof" if self.ever_played else "error")
            self.loading_until = time.time() + self.LOAD_GRACE   # don't repeat
        return ev


# ---------------------------------------------------------------- keyboards
class Keyboards:
    def __init__(self, sel):
        self.sel = sel
        self.devs = {}

    def rescan(self):
        have = {d.path for d in self.devs.values()}
        for path in evdev.list_devices():
            if path in have:
                continue
            try:
                d = evdev.InputDevice(path)
                keys = d.capabilities().get(ec.EV_KEY, [])
                if not all(k in keys for k in (ec.KEY_Z, ec.KEY_C, ec.KEY_Q, ec.KEY_TAB)):
                    d.close()
                    continue
                os.set_blocking(d.fd, False)
                self.sel.register(d.fd, selectors.EVENT_READ, ("kbd", d))
                self.devs[d.fd] = d
                dbg("keyboard:", d.name, path)
            except OSError:
                continue

    def drop(self, d):
        try:
            self.sel.unregister(d.fd)
        except (KeyError, ValueError):
            pass
        self.devs.pop(d.fd, None)
        try:
            d.close()
        except OSError:
            pass

    def read(self, d):
        """Return list of actions from device d."""
        out = []
        try:
            for e in d.read():
                if e.type != ec.EV_KEY:
                    continue
                act = KEYMAP.get(e.code)
                if act is None:
                    continue
                if e.value == 1 or (e.value == 2 and act in REPEATABLE):
                    out.append(act)
        except BlockingIOError:
            pass
        except OSError:
            self.drop(d)
        return out


# ---------------------------------------------------------------- USB drives
class UsbDrives:
    """Finds USB drives, mounts them read-only, and says where their videos are.

    The desktop normally automounts drives, but it is stopped while HDMI plays, so
    the player does it: first with udisks (when the system allows it), otherwise
    with "sudo -n mount" / "sudo -n umount" (the stock image's passwordless sudo).
    Drives are mounted read-only (nosuid, nodev, noexec) under MOUNT_ROOT and
    unmounted when pulled or when the player quits. Work happens in a thread; the
    player only reads .dir (the videos folder on the first drive that has some)."""
    MOUNT_ROOT = "/media/strawberry-video-player"
    FSTYPES = {"vfat", "exfat", "ntfs", "ext2", "ext3", "ext4"}

    def __init__(self):
        self.dir = None              # videos folder on a drive, or None
        self.label = ""
        self.ours = {}               # device -> mount point we created
        self.worker = None
        self.cmd_ok = {}             # does sudo/udisks work here (remembered)

    # -- discovery
    def partitions(self):
        try:
            r = subprocess.run(["lsblk", "-J", "-o", "NAME,PKNAME,PATH,TYPE,FSTYPE,LABEL,MOUNTPOINTS,TRAN"],
                               capture_output=True, timeout=10, stdin=subprocess.DEVNULL)
            tree = json.loads(r.stdout or b"{}")
        except (OSError, subprocess.SubprocessError, ValueError):
            return []
        nodes = []                                      # lsblk nests or lists flat: handle both

        def flatten(node, parent):
            if parent and not node.get("pkname"):
                node = dict(node, pkname=parent)
            nodes.append(node)
            for c in node.get("children") or []:
                flatten(c, node.get("name"))
        for n in tree.get("blockdevices", []):
            flatten(n, None)
        by_name = {n.get("name"): n for n in nodes}

        def on_usb(node):
            seen = 0
            while node and seen < 5:                    # a partition is on USB when its disk is
                if node.get("tran") == "usb":           # (not "hotplug": the SD card has that)
                    return True
                node = by_name.get(node.get("pkname"))
                seen += 1
            return False
        out = []
        for n in nodes:
            if n.get("type") in ("part", "disk") and n.get("fstype") in self.FSTYPES and on_usb(n):
                mps = [m for m in (n.get("mountpoints") or []) if m]
                out.append({"dev": n["path"], "fstype": n["fstype"],
                            "label": n.get("label") or "", "mount": mps[0] if mps else None})
        return out

    # -- mounting
    def _run(self, cmd, timeout=40):
        try:
            r = subprocess.run(cmd, capture_output=True, timeout=timeout, stdin=subprocess.DEVNULL)
            if r.returncode != 0:
                dbg("usb:", " ".join(cmd), "->", r.stderr.decode(errors="replace").strip())
            return r
        except (OSError, subprocess.SubprocessError) as e:
            dbg("usb:", cmd[0], "failed:", e)
            return None

    def mount(self, part):
        dev, fs = part["dev"], part["fstype"]
        name = re.sub(r"[^A-Za-z0-9._-]", "_", part["label"] or os.path.basename(dev)) or "usb"
        target = os.path.join(self.MOUNT_ROOT, name)
        if os.path.ismount(target):
            target += "-" + os.path.basename(dev)
        opts = "ro,nosuid,nodev,noexec"
        if fs in ("vfat", "exfat", "ntfs"):
            opts += ",uid=%d,gid=%d,umask=022" % (os.getuid(), os.getgid())
        if fs == "vfat":
            opts += ",utf8"
        typ = "ntfs-3g" if fs == "ntfs" else fs
        steps = [["sudo", "-n", "mkdir", "-p", target],
                 ["sudo", "-n", "mount", "-t", typ, "-o", opts, dev, target]]
        for cmd in steps:
            r = self._run(cmd)
            if r is None or r.returncode != 0:
                self._run(["sudo", "-n", "rmdir", target])
                return None
        log("USB drive mounted:", dev, "->", target)
        return target

    def unmount(self, target):
        r = self._run(["sudo", "-n", "umount", "-l", target])
        if r is not None and r.returncode == 0:
            self._run(["sudo", "-n", "rmdir", target])

    # -- the videos folder on a mounted drive
    @staticmethod
    def videos_dir(mount):
        try:
            names = sorted(os.listdir(mount), key=str.casefold)
        except OSError:
            return None
        cands = [os.path.join(mount, n) for n in names
                 if n.casefold() == "videos" and os.path.isdir(os.path.join(mount, n))]
        for d in cands + [mount]:
            if scan(d):
                return d
        return None

    def update(self):
        parts = self.partitions()
        present = {p["dev"] for p in parts}
        for dev in list(self.ours):                     # drive pulled: let go of its mount
            if dev not in present:
                self.unmount(self.ours.pop(dev))
        found, label = None, ""
        for part in parts:
            mount = part["mount"]
            if not mount:
                if part["dev"] in self.ours:
                    mount = self.ours[part["dev"]]
                else:
                    mount = self.mount(part)
                    if mount:
                        self.ours[part["dev"]] = mount
            if mount and not found:
                d = self.videos_dir(mount)
                if d:
                    found, label = d, part["label"] or os.path.basename(part["dev"])
        self.label = label
        self.dir = found

    def _loop(self):
        try:
            self.update()
        except Exception as e:                          # never take the player down
            dbg("usb update failed:", e)

    def refresh(self, wait=False):
        """Look for drives in the background (or now, with wait=True)."""
        if self.worker and self.worker.is_alive():
            if wait:
                self.worker.join()
            return
        self.worker = threading.Thread(target=self._loop, daemon=True)
        self.worker.start()
        if wait:
            self.worker.join()

    def close(self):
        if self.worker and self.worker.is_alive():
            self.worker.join(15)
        for dev in list(self.ours):
            self.unmount(self.ours.pop(dev))
        self.dir = None


# ---------------------------------------------------------------- the player
class App:
    def __init__(self, directory, first_file=None, start_at=0.0, output=None, use_usb=True):
        self.base_dir = directory
        self.use_usb = use_usb
        self.resume_map = resume_load()     # "path|size" -> seconds, for videos >= RESUME_MIN_LENGTH
        self.resume_saved = 0.0
        self.pos_file = None            # the file last_pos belongs to
        self.usb = UsbDrives()
        if use_usb:                                 # a drive that is already in plays first
            self.usb.refresh(wait=True)
        self.usb_seen = self.dir
        self.files = scan(self.dir)
        self.idx = 0
        if first_file and first_file in self.files:
            self.idx = self.files.index(first_file)
        self.loop_one = True            # default: loop the current video
        self.aspect = initial_aspect()  # display shape, keys 1-8
        self.diag_auto = False          # diagnostics page is up because HDMI was just acquired
        self.pattern = -1               # test pattern showing (index into PATTERNS), -1 = none
        self.last_pattern = 0           # the one t brings back
        self.resume = None              # (position, paused) of the video to return to
        self.diag_first = 0.0
        self.volume = 100               # percent
        self.muted = False
        self.lease = DesktopLease()
        self.start_at = start_at
        self.info = LcdInfo()
        self.backlight = Backlight()
        self.length = None
        # HDMI backend: "vlc" (hardware, desktop stopped) or "mpv" (desktop window)
        want = os.environ.get("STRAWBERRY_HDMI_BACKEND")
        self.hdmi_backend = want if want in ("vlc", "mpv") else (
            "vlc" if shutil.which("cvlc") else "mpv")
        self.output = output or ("hdmi" if self.hdmi_usable() else "lcd")
        self.engine = None
        self.errors = 0
        self.crashes = 0
        self.last_pos = None
        self.stall = 0
        self.recoveries = 0
        self.prober = Prober()
        self.sw_files = set()           # files that stalled in hardware: use software
        self.quitting = False
        self.sel = selectors.DefaultSelector()
        self.kbd = Keyboards(self.sel)
        self.sel_fd = None

    @property
    def dir(self):
        """Where videos come from: a USB drive while one with videos is in, else the folder."""
        return self.usb.dir or self.base_dir

    @property
    def paused(self):
        return bool(self.engine and self.engine.paused)

    def hdmi_usable(self):
        if not hdmi_connected():
            return False
        return self.hdmi_backend == "vlc" or wayland_display() is not None

    # -- engine lifecycle
    def make_engine(self):
        if self.output == "hdmi" and self.hdmi_backend == "vlc":
            e = VlcEngine(self.loop_one, self.lease, self.aspect)
            e.mode = self.decoder_mode(self.current())[0]    # start in the right mode
            return e
        return MpvEngine(self.output, self.loop_one)

    def start_engine(self):
        self.engine = self.make_engine()
        if not self.engine.start():
            self.engine = None
            return False
        fd = self.engine.fileno()
        if fd is not None:
            self.sel.register(fd, selectors.EVENT_READ, ("engine", None))
            self.sel_fd = fd
        try:
            self.engine.set_volume(self.volume, self.muted)
        except OSError:
            pass
        return True

    def stop_engine(self, release=True):
        if self.sel_fd is not None:
            try:
                self.sel.unregister(self.sel_fd)
            except (KeyError, ValueError):
                pass
            self.sel_fd = None
        if self.engine:
            self.engine.stop(release)
            self.engine = None

    def open_output(self):
        """Start an engine for the current output, falling back as needed:
        HDMI/VLC -> HDMI/mpv window -> LCD."""
        while True:
            if self.start_engine():
                return True
            log(f"could not start {self.output}/{self.hdmi_backend}")
            if self.output == "hdmi" and self.hdmi_backend == "vlc":
                self.hdmi_backend = "mpv"
                if not self.wait_wayland():
                    self.output = "lcd"
            elif self.output == "hdmi":
                self.output = "lcd"
            else:
                return False

    def wait_wayland(self, timeout=25):
        end = time.time() + timeout
        while time.time() < end:
            if wayland_display() is not None:
                return True
            time.sleep(0.5)
        return False

    # -- actions
    def say(self, text, ms=1500):
        if self.engine:
            self.engine.say(text, ms)
            if self.engine.name == "vlc":            # no OSD on HDMI: use the LCD page
                self.info.notice(text, min(ms, 4000) / 1000.0)
        elif not self.files:
            self.info.notice(text, min(ms, 4000) / 1000.0)

    def current(self):
        return self.files[self.idx] if self.files else None

    def decoder_mode(self, f):
        """("sw" | "default", reason) for the VLC process that will play file f."""
        if not f:
            return "default", ""
        sw, why = self.prober.needs_software(f)
        if f in self.sw_files and not sw:
            sw, why = True, "stalled in hardware earlier"
        return ("sw" if sw else "default"), why

    def resume_position(self, f):
        k = resume_key(f)
        pos = self.resume_map.get(k) if k else None
        return float(pos) if isinstance(pos, (int, float)) else 0.0

    def note_position(self, force=False):
        """Remember where a long video is, so it resumes there next time."""
        f, pos, length = self.pos_file, self.last_pos, self.length
        if not f or pos is None or self.pattern >= 0:
            return
        if not length and self.engine:               # (VLC may not know it yet at load: keep asking)
            try:
                length = self.engine.length()
            except OSError:
                return
            if length:
                self.length = length
        if not length or length < RESUME_MIN_LENGTH:
            return
        k = resume_key(f)
        if not k:
            return
        dirty = False
        if RESUME_EDGE[0] < pos < length - RESUME_EDGE[1]:
            if self.resume_map.get(k) != int(pos):
                self.resume_map.pop(k, None)
                self.resume_map[k] = int(pos)               # newest last
                dirty = True
        elif pos >= length - RESUME_EDGE[1] and k in self.resume_map:   # played to the end: forget it
            del self.resume_map[k]
            dirty = True
        if dirty and (force or time.time() - self.resume_saved >= 5.0):
            self.resume_saved = time.time()
            try:
                os.makedirs(os.path.dirname(RESUME_STATE), exist_ok=True)
                keep = dict(list(self.resume_map.items())[-50:])
                tmp = RESUME_STATE + ".tmp"
                with open(tmp, "w") as fh:
                    json.dump(keep, fh)
                os.replace(tmp, RESUME_STATE)
            except OSError as e:
                dbg("resume state not saved:", e)

    def load(self, start=0.0, paused=False, announce=True):
        f = self.current()
        if not f:
            self.say(f"No videos in {self.dir}", 3600000)
            return
        self.note_position(force=True)              # where the previous video was
        resumed = 0.0
        if start == 0 and announce:                  # a fresh start of a video: pick up where it was
            resumed = start = self.resume_position(f)
        self.pos_file = f
        self.last_pos, self.stall = None, 0
        self.length = None
        mode = "default"
        if self.engine.name == "vlc":
            mode, why = self.decoder_mode(f)
            log("%s: %s decoding%s" % (os.path.basename(f),
                                      "software" if mode == "sw" else "hardware",
                                      " (" + why + ")" if why else ""))
        self.engine.load(f, start, paused, mode)
        if announce:
            self.say(f"{self.idx + 1}/{len(self.files)}  "
                     f"{os.path.splitext(os.path.basename(f))[0]}"
                     + (f"  (resumed {hms(resumed)})" if resumed else ""), 2500)

    def advance(self, step):
        new = scan(self.dir)
        if new != self.files:
            cur = self.current()
            self.files = new
            self.idx = self.files.index(cur) if cur in self.files else 0
        if not self.files:
            self.load()
            return
        self.idx = (self.idx + step) % len(self.files)
        self.load()

    def do(self, act):
        self._do(act)
        self.update_info()

    def _do(self, act):
        dbg("action", act)
        if act == "quit":
            self.quitting = True
        elif act == "output":
            if self.engine:                            # (nothing to move when no video is loaded)
                self.switch_output("lcd" if self.output == "hdmi" else "hdmi")
        elif act == "pattern":
            self.next_pattern()
        elif not self.engine:
            return
        elif act == "pause":
            self.say(self.engine.toggle_pause(), 1000)
        elif act in ("prev", "next"):
            step = 1 if act == "next" else -1
            if self.pattern >= 0:                     # z x c f choose the test pattern
                self.pattern = (self.pattern + step) % len(PATTERNS)
                self.show_pattern()
            else:
                self.advance(step)
        elif act == "back":
            self.engine.seek_rel(-SEEK_SECONDS)
            self.say(f"-{SEEK_SECONDS}s", 800)
        elif act == "fwd":
            self.engine.seek_rel(SEEK_SECONDS)
            self.say(f"+{SEEK_SECONDS}s", 800)
        elif act == "subs":
            if self.pattern < 0:
                self.say(self.engine.sub_cycle() if self.engine.name == "vlc"
                         else "Subtitles: HDMI only", 2500)
        elif act in ("vol_up", "vol_down", "mute"):
            if act == "mute":
                self.muted = not self.muted
            else:
                self.muted = False
                self.volume = max(0, min(100, self.volume
                                         + (VOLUME_STEP if act == "vol_up" else -VOLUME_STEP)))
            self.engine.set_volume(self.volume, self.muted)
            self.say("Muted" if self.muted else f"Volume {self.volume}%", 1000)
        elif act == "help":
            if self.engine.name == "mpv":
                self.engine.say("\n".join(f"{k:<10}{v}" for k, v in HELP_LINES), 8000)
            else:
                self.info.show_help()
        elif act == "diag":
            if self.engine.name == "vlc" and self.output == "hdmi":
                self.diag_auto = False                # the user is in charge now
                self.info.toggle_diag()
                self.update_info()
            else:
                self.say("HDMI diagnostics show on the LCD while HDMI plays", 2500)
        elif act.startswith("aspect"):
            self.set_aspect(ASPECTS[int(act[6:])])
        elif act == "loop":
            self.loop_one = not self.loop_one
            self.engine.set_loop_one(self.loop_one)
            self.say("Loop: this video" if self.loop_one else "Loop: all videos", 1500)

    def next_pattern(self):
        """Key t: test patterns on (the one used last) or off (the video resumes)."""
        if self.pattern >= 0:
            self.end_pattern()
            return
        if self.engine is None:                       # no videos: bring HDMI up just for this
            if not (hdmi_connected() and self.hdmi_backend == "vlc" and shutil.which("cvlc")):
                self.say("Test patterns need HDMI", 3000)
                return
            self.output = "hdmi"
            self.say("Starting HDMI...", 3000)
            self.update_info()
            if not self.start_engine():
                self.say("Could not start HDMI", 3000)
                return
            self.resume = None
        elif not (self.engine.name == "vlc" and self.output == "hdmi"):
            self.say("Test patterns need HDMI", 2000)
            return
        else:
            self.resume = (self.engine.position() or self.last_pos or 0.0, self.paused)
        self.pattern = self.last_pattern
        self.show_pattern()

    def show_pattern(self):
        title, name = PATTERNS[self.pattern]
        self.last_pattern = self.pattern
        path = os.path.join(PATTERN_DIR, name)
        if not os.path.exists(path):
            self.say("Test pattern missing: " + name, 2500)
            self.end_pattern()
            return
        self.last_pos, self.stall, self.length = None, 0, None
        self.engine.load(path, 0.0, False, "default")
        self.say("Pattern %d/%d: %s" % (self.pattern + 1, len(PATTERNS), title), 3000)
        self.update_info()

    def end_pattern(self):
        pos, paused = self.resume or (0.0, False)
        self.pattern, self.resume = -1, None
        if not self.files:                            # nothing to resume: HDMI off, desktop back
            self.stop_engine()
            self.say("Test patterns off", 2500)
            self.update_info()
            return
        self.load(start=float(pos), paused=paused, announce=False)
        self.say("Test patterns off", 1500)

    def set_aspect(self, text):
        """Keys 1-8: tell the player the shape of the display. VLC reads it at start,
        so on HDMI the player restarts (the desktop stays stopped) at the same spot."""
        if self.engine.name != "vlc":
            self.say("Aspect ratio applies to HDMI", 2000)
            return
        if text == self.aspect:
            self.say("Aspect: " + text, 1500)
            return
        self.aspect = text
        conf_set("display_aspect", text)
        pos = (self.engine.position() or self.last_pos or 0.0)
        paused = self.paused
        self.say("Aspect: " + text, 4000)
        self.update_info()                           # show it now, the restart takes a few s
        self.stop_engine(release=False)
        if self.start_engine():
            if self.pattern >= 0:
                self.show_pattern()
            else:
                self.load(start=float(pos), paused=paused, announce=False)
        else:
            self.quitting = True

    def handle(self, events):
        if self.pattern >= 0:                          # stills: no end-of-file / errors to act on
            return
        for ev in events:
            if ev == "loaded":
                self.errors = 0
                if self.engine.name == "vlc":
                    self.length = self.engine.length()
            elif ev == "eof":
                if self.loop_one and self.engine and self.engine.name == "mpv":
                    continue                      # mpv loops by itself
                self.advance(0 if self.loop_one else 1)
            elif ev == "error":
                self.errors += 1
                if self.engine.name == "vlc" and self.errors >= 2:
                    # two failures in a row: the output, not the files, is the problem
                    self.fall_back_from_vlc()
                    return
                if self.errors >= max(1, len(self.files)):
                    self.say("No playable videos")
                else:
                    self.advance(1)

    def begin_diag(self):
        """HDMI was just acquired: show the diagnostics page for DIAG_AT_ACQUIRE
        seconds, and longer if playback has not begun by then."""
        self.diag_auto, self.diag_first = True, 0.0
        dbg("diag: HDMI acquired")

    def auto_diag(self):
        if not self.diag_auto:
            return
        now = time.time()
        if not self.diag_first:                      # clock starts when the page can first show
            self.diag_first = now
            dbg("diag: showing")
        shown = now - self.diag_first
        playing = self.last_pos is not None and self.last_pos > 0.2
        if shown >= DIAG_AT_ACQUIRE and (playing or shown >= DIAG_MAX_WAIT):
            self.diag_auto = False
            self.info.diag_until = 0.0
            self.info.last = None
            dbg("diag: done after %.1fs (playing=%s)" % (shown, playing))
        else:
            self.info.diag_until = now + 5.0         # keep it up

    def update_info(self):
        """Keep the LCD info page in step while HDMI plays; release the LCD otherwise."""
        if self.engine and self.engine.name == "vlc" and self.output == "hdmi":
            if self.info.open():
                self.auto_diag()
                f = self.current()
                title = os.path.splitext(os.path.basename(f))[0] if f else ""
                if self.pattern >= 0:
                    self.info.draw("Pattern %d/%d: %s" % (self.pattern + 1, len(PATTERNS),
                                                          PATTERNS[self.pattern][0]),
                                   "Test pattern  t:off  z/c:next", None, None, self.volume, self.muted)
                else:
                    self.info.draw(title, "Paused" if self.paused else "Playing",
                                   self.last_pos, self.length, self.volume, self.muted)
        elif (self.engine and self.engine.name == "mpv" and self.output == "hdmi"
              and self.hdmi_backend == "mpv" and self.lease.failed):
            if self.info.open():
                self.info.setup()
        elif self.engine is None and not self.files:
            if self.info.open():
                self.info.empty(self.dir, hdmi_ok=hdmi_connected() and self.hdmi_backend == "vlc")
        else:
            self.info.close()

    def switch_output(self, target, note=None):
        if target == "hdmi" and not self.hdmi_usable():
            self.say("HDMI not connected", 1500)
            return
        if target == self.output and self.engine:
            return
        pos = (self.engine.position() if self.engine else None) or 0.0
        paused = self.paused
        if self.pattern >= 0 and self.resume:         # back to the video, not the pattern
            pos, paused = self.resume
        self.pattern, self.resume = -1, None
        self.info.close()
        # HDMI -> LCD: keep the desktop stopped. Restarting it just as the LCD player
        # opens the panel makes the new desktop session take the display away from it
        # (sound but no picture, then the login screen). The LCD does not need it; it is
        # restarted when the player quits.
        self.stop_engine(release=(target != "lcd"))
        self.output = target
        if not self.open_output():
            self.quitting = True
            return
        self.load(start=float(pos), paused=paused, announce=False)
        if self.output == "hdmi" and self.engine and self.engine.name == "vlc":
            self.begin_diag()
        self.say(note or ("Output: HDMI" if self.output == "hdmi" else "Output: LCD"), 1500)

    def fall_back_from_vlc(self):
        log("HDMI playback through VLC failed; using a desktop window instead")
        self.errors = 0
        self.hdmi_backend = "mpv"
        paused, pos = self.paused, self.last_pos or 0.0
        self.stop_engine()
        if not self.wait_wayland():
            self.output = "lcd"
        if self.open_output():
            self.load(start=pos, paused=paused, announce=False)
        else:
            self.quitting = True

    # -- main loop
    def run(self):
        for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(s, lambda *_: setattr(self, "quitting", True))
        self.kbd.rescan()
        self.backlight.hold()                    # remember the current (awake) level
        started = False
        if self.info.open():
            self.info.page("splash")
            end = time.time() + SPLASH_SECONDS
            if self.files and self.output == "hdmi":
                # The splash is on the LCD, HDMI is a separate display: bring HDMI up
                # and load the first video while the splash is still showing.
                if not self.open_output():
                    log("could not start any player")
                    self.info.close()
                    return 1
                if self.output != "hdmi":        # fell back to the LCD: the video owns it now
                    self.info.saved = None        # do not paint the old screen over it
                    self.info.close()
                    end = 0
                self.load(start=self.start_at)
                if self.output == "hdmi" and self.engine and self.engine.name == "vlc":
                    self.begin_diag()
                started = True
            self.hold_splash(end)
        if not started and self.files:
            self.info.close()
            if not self.open_output():
                log("could not start any player")
                return 1
            self.load(start=self.start_at)
        # no videos: the LCD keeps the "No videos found" page; key t starts HDMI test
        # patterns, and playback starts by itself when videos appear (see housekeeping)
        self.prober.prefetch([f for f in self.files if f != self.current()])
        tick = 0
        last = time.time()
        try:
            while not self.quitting:
                self.backlight.hold()
                for key, _ in self.sel.select(0.25):
                    kind, d = key.data
                    try:
                        if kind == "kbd":
                            for act in self.kbd.read(d):
                                self.do(act)
                        elif kind == "engine" and self.engine:
                            self.handle(self.engine.pump())
                    except OSError as e:          # player just died; housekeeping recovers
                        dbg("engine I/O error:", e)
                if time.time() - last >= 1.0:
                    last = time.time()
                    tick += 1
                    try:
                        self.housekeeping(tick)
                    except OSError as e:
                        dbg("housekeeping I/O error:", e)
        finally:
            self.info.close()
            try:
                self.note_position(force=True)
            except Exception:
                pass
            self.stop_engine()
            self.lease.release()            # desktop back (no-op if not held)
            self.usb.close()
        return 0

    def hold_splash(self, end):
        """Keep the splash up until `end`; any player key skips the rest."""
        while time.time() < end and not self.quitting:
            self.backlight.hold()
            self.info.refresh()
            for key, _ in self.sel.select(0.25):
                kind = key.data[0]
                if kind == "kbd":
                    if self.kbd.read(key.data[1]):
                        end = 0
                elif kind == "engine" and self.engine:
                    try:
                        self.handle(self.engine.pump())    # keep the player's pipe drained
                    except OSError:
                        pass

    def watchdog(self):
        """If playback stops advancing while not paused, the decoder has stalled:
        restart the engine (VLC: with software decoding) at the same spot."""
        if not self.engine or self.paused or not self.files or self.pattern >= 0:
            self.stall = 0
            return
        pos = self.engine.position(0.4)
        if pos is not None and pos != self.last_pos:
            self.last_pos, self.stall = pos, 0
            return
        self.stall += 1
        limit = 8 if self.last_pos is not None else 60     # slow cold opens get longer
        if self.stall >= limit and self.recoveries < 3:
            self.recoveries += 1
            log("playback stalled; restarting the player (recovery %d)" % self.recoveries)
            if self.engine.name == "vlc" and self.recoveries >= 2 and self.current():
                self.sw_files.add(self.current())   # software decode only after a retry
            at, self.stall = self.last_pos or 0.0, 0
            self.stop_engine(release=False)         # keep the desktop stopped
            if self.start_engine():
                self.load(start=at, paused=False, announce=False)
            else:
                self.quitting = True

    def usb_changed(self):
        """A drive with videos came or went: switch the playlist."""
        if self.pattern >= 0:                     # (try again when the pattern is switched off)
            return
        self.usb_seen = self.dir
        self.files = scan(self.dir)
        self.idx = 0
        if self.usb.dir:
            self.say("USB drive: " + self.usb.label, 3000)
        if self.files:
            if self.engine:
                self.load()
            else:
                self.info.close()
                if not self.open_output():
                    self.quitting = True
                    return
                self.load()
        elif self.engine:
            self.stop_engine()                    # nothing left to play: back to the empty page

    def housekeeping(self, tick):
        if tick % 2 == 0 and self.use_usb:
            self.usb.refresh()
        if self.dir != self.usb_seen:
            self.usb_changed()
        if tick % 5 == 0:
            self.kbd.rescan()
        if self.engine and not self.engine.alive():          # player died by itself
            self.crashes += 1
            log("%s exited unexpectedly (code %s), output was %s"
                % (self.engine.name, self.engine.exit_code(), self.output))
            pos, paused = self.last_pos or 0.0, self.paused
            self.stop_engine()
            if self.crashes > 3:
                self.quitting = True
                return
            if self.output == "hdmi":
                if self.hdmi_backend == "vlc":
                    self.hdmi_backend = "mpv"
                    if not self.wait_wayland():
                        self.output = "lcd"
                else:
                    self.output = "lcd"
            if self.open_output():
                self.load(start=pos, paused=paused, announce=False)
            else:
                self.quitting = True
            return
        if self.engine:
            self.handle(self.engine.poll())
        self.watchdog()
        self.note_position()
        self.update_info()
        if self.engine and self.output == "hdmi" and not hdmi_connected():
            self.switch_output("lcd", note="HDMI unplugged: LCD")
        if not self.files and tick % 2 == 0:
            self.files = scan(self.dir)
            if self.files:
                self.idx = 0
                if self.pattern < 0:                 # (with a pattern up it starts when that ends)
                    if not self.engine:
                        self.info.close()
                        if not self.open_output():
                            self.quitting = True
                            return
                    self.load()


def parse_time(text):
    secs = 0.0
    for part in text.split(":"):
        secs = secs * 60 + float(part)
    return secs


RULE_PATH = "/usr/share/polkit-1/rules.d/50-strawberry-video-player.rules"
RULE_TEXT = """// Installed by "sudo strawberry-video-player --setup"; remove with --unsetup.
// Lets members of the video group stop and start the desktop (lightdm) so the
// Strawberry Video Player can use the HDMI display directly.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "lightdm.service" &&
        (action.lookup("verb") == "stop" || action.lookup("verb") == "start") &&
        subject.isInGroup("video")) { return polkit.Result.YES; }
});
"""


def setup_main(remove):
    """--setup / --unsetup: install or remove the polkit rule (needs root)."""
    if os.geteuid() != 0:
        print("This needs administrator rights; running it with sudo.", flush=True)
        os.execvp("sudo", ["sudo", sys.executable, os.path.abspath(sys.argv[0])] + sys.argv[1:])
    if remove:
        try:
            os.unlink(RULE_PATH)
            print("Removed. HDMI will play in a desktop window (less smooth at 1080p).")
        except FileNotFoundError:
            print("Nothing to remove: the rule is not installed.")
        return 0
    try:
        if os.path.exists(RULE_PATH) and open(RULE_PATH).read() == RULE_TEXT:
            print("Already set up. HDMI uses the smooth full-screen mode.")
            return 0
        tmp = RULE_PATH + ".tmp"
        with open(tmp, "w") as f:
            f.write(RULE_TEXT)
        os.chmod(tmp, 0o644)
        os.replace(tmp, RULE_PATH)
    except OSError as e:
        print("Could not write", RULE_PATH + ":", e, file=sys.stderr)
        return 1
    user = os.environ.get("SUDO_USER") or "pi"
    try:
        import grp
        if user not in grp.getgrnam("video").gr_mem:
            print(f"Note: user {user} is not in the video group; run: sudo usermod -aG video {user}")
    except (KeyError, ImportError):
        pass
    print("Done. HDMI will now play smooth full-screen. Restart the player to use it.")
    print("To undo: sudo strawberry-video-player --unsetup")
    return 0


def main():
    args = sys.argv[1:]
    start = 0.0
    if "--start" in args:
        i = args.index("--start")
        try:
            start = parse_time(args[i + 1])
        except (IndexError, ValueError):
            print("usage: --start SECONDS|MM:SS", file=sys.stderr)
            return 2
        del args[i:i + 2]
    output = None
    if "--output" in args:
        i = args.index("--output")
        if i + 1 >= len(args) or args[i + 1] not in ("lcd", "hdmi"):
            print("usage: --output lcd|hdmi", file=sys.stderr)
            return 2
        output = args[i + 1]
        del args[i:i + 2]
    arg = args[0] if args else None
    if arg in ("-h", "--help"):
        print(__doc__)
        return 0
    if arg in ("--setup", "--unsetup"):
        return setup_main(arg == "--unsetup")
    if arg == "--version":
        print("strawberry-video-player", VERSION)
        return 0
    first = None
    if arg and os.path.isfile(arg):
        first = os.path.abspath(arg)
        directory = os.path.dirname(first)
    else:
        directory = os.path.abspath(arg) if arg else os.path.expanduser("~/Videos")
    return App(directory, first, start, output, use_usb=not arg).run()


if __name__ == "__main__":
    sys.exit(main())
